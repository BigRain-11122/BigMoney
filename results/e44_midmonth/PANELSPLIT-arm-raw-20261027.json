 "screening": {
  "screened_legs": [
   "staletail (E74: events inside the stale tail)"
  ],
  "unscreened_rule": "every census leg in this file charges per-name returns out of the same e27.load_universe() closes, so an unadjusted print enters any equal-weight number at weight 1/n; only staletail screens for it",

 "answers": {
  "does_a_persistent_read_reach_the_curve": true,
  "how_do_the_two_readings_differ": "the arm-vs-arm curve delta pays for selection as well as the read, so it is published beside the read effect, never as it",
  "drawdown_moves_too": true
 },
 "honest": [
  "the read effect is a counterfactual on the SAME holdings, not a re-burn: it answers 'what does the read alone do to this curve', not 'what would the other arm have earned'",

 "rules": {
  "population": "a source names <stem>_latest.json outside its selftest region and names no dated cut or template of the same stem",
  "reader": "not every occurrence writes the pointer",
  "pointer_only": "the pointer is not a candidate in an ordered container and not handed to a helper that loops over candidates",
  "load_site": "a line that opens the pointer directly or calls a helper whose own body opens a file",
  "handling precedence": "existence test, then try/except, then `or {}`, then a None branch after the load, then the helper's contract"
 },
 "limits": {
  "static": "a reader that resolves a pointer through a computed name is not seen, which under-counts the population rather than over-counting a finding",
  "helper_scope": "a helper defined outside scripts/Tools/live/monitor/firm is not in the corpus, so its contract is reported as unknown and its caller as loud",
  "single_line": "a try: block is detected at the indent of the loading line; a load inside a one-line `try: ... except ...` is out of population for this measurement",
  "presence_not_behaviour": "the tool never deletes a pointer to watch a reader fire; the disk half reports what would be missing if it did",
  "fixture_strings": "a pointer name inside a quoted string that forms no code (a doc row, a fixture) is not an occurrence",
  "invisible_tail": "the corpus helper drops a triple-quoted block to its end, so a source whose docstring logic continues past a point loses the rest of its lines; the count of such sources is published because a load site in that tail cannot be seen (e312 is one)"
 },

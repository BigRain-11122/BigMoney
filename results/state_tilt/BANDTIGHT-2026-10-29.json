 "frozen_spec": {
  "design": "read E259's published p05..p95 interval per (window, leg, base count) and judge each published row with a donor window's TIGHT end instead of its own -- the mirror of E262, on the same rows",
  "dominator_rule": "'use the tightest' is a safe single number only when one arm's p05 is <= every other arm's p05 in the same (leg, base)",
  "flat_rule": "one number per (leg, base) = the pooled MINIMUM p05, which is what 'use the tightest' actually adopts; the pooled maximum is published beside it as the loose alternative",
  "judge_rule": "verdict = outside(b, band*m) with m the borrowed p05; a smaller multiplier NARROWS the band, so a donor p05 above the row's own INVENTS a rejection rather than losing one -- direction is published",
  "match_rule": "a transfer is published only within one (leg, base count); the multiplier's denominator is the base count itself",
  "no_new_draws": "no shuffle stream is drawn; every number is a function of the two faces",
  "tolerance": 1e-12,
  "verdict_rule": "the tight end 'transfers' only if no pair moves a verdict; a moved verdict is published with its direction, never netted out"
 },

{
 "arms": {
  "A0_baseline_resolver": {
   "kind": "suffix index",
   "skips": [
    ".codely-cli",
    ".git",
    "Money02",
    "__pycache__",
    "legacy",
    "media"
   ]
  },
  "A1_wider_index": {
   "kind": "suffix index",
   "skips": [
    ".git",
    "__pycache__"
   ]
  },
  "A2_git_history": {
   "kind": "git log --diff-filter=D --name-only",
   "ran": false,
   "why": "not attempted: this clone is a promisor/partial clone, so any history walk starts a lazy fetch (r1224 family); set BIGMONEY_E399_HISTORY=1 on a complete clone to run it"
  },
  "A3_form": {
   "absolute": "drive letter or leading /",
   "bare_basename": "no slash, known extension",
   "bare_token": "no slash, no extension",
   "repo_relative": "has a slash",
   "template": [
    "%s",
    "{",
    "}",
    "*",
    "?",
    "<",
    ">",
    "$",
    "+"
   ]
  },
  "A4_neighbourhood": {
   "asks": [
    "parent_exists",
    "parent_is_a_file",
    "same_stem_other_date"
   ]
  }
 },
 "bounds": {
  "measured": "each published key with no file in the baseline resolver tested against a wider index (only .git/__pycache__ skipped), a form test (path vs basename vs token vs template vs absolute), and a neighbourhood test for repo-relative absences (directory exists, directory path is a file, same-stem sibling under another date)",
  "no_rewrites": "no published face, pointer or key is edited here",
  "not_measured": "whether a consumer of an unresolved name would find its file by another cwd-relative base (E383's suffix rule is the weakest claim that still distinguishes two files); git history (arm off -- see A2.why)"
 },

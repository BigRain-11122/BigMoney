 "rules": {
  "one_corpus": "every consumer runs over e326.corpus(), so a delta is the reading and nothing else",
  "landed_name": "the tokenized builds use the name E335 landed on the helper module, not the wrapper E334 used to price the repair",
  "two_readings": "delta = shipped build vs tokenized build (how wrong is the consumer); publish = published face vs tokenized build (what a reader must re-read); they are different quantities and may order differently",
  "verdict_survival": "a consumer's published verdict is compared with the verdict its tokenized build reaches, never with the shipped build's -- the shipped build is the thing being replaced",
  "frozen_rule": "decide() is code: the named candidate cannot drift from the numbers",
  "self_inclusion": "this study's own face and latest pointer are dropped from the corpus before any build (E204/E319 class)"
 },
 "limits": {
  "consumer_set": "the six consumers E334 registered; E332 and E333 are excluded there and stay excluded here",
  "recovered_axis": "the recovered-code-line axis is read from the E332 face rather than rebuilt, because rebuilding it is E332's own measurement",
  "builds": "12 builds (six consumers x shipped/tokenized), no ablation: a per-consumer price does not need attribution, it needs a count"
 }

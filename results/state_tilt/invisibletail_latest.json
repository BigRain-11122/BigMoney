 "rules": {
  "recovery": "a line is recovered when the real tokenizer finds a token on it that is not STRING/COMMENT/NL/NEWLINE/INDENT/DEDENT/ENCODING/ENDMARKER and the corpus helper does not show that line number",
  "helper_failure": "the helper flips into doc mode on a line that *starts* with a triple quote and carries an odd count of them; a continuation line that opens with a closing delimiter is read as an opener, and the flag re-synchronises one literal later in the wrong phase",
  "reprice": "E331's own build() is run twice over the same file list, once with the shipped helper and once with a tokenizer-backed one; the patched helper is restored in a finally block and the restore is asserted",
  "no_silent_substitution": "the recovered text is never used to overwrite a published face; the delta is reported beside the shipped numbers"
 },

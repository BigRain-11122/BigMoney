 "lines": [
  {
   "start": 0.0,
   "end": 5.0,
   "text": "詞曲 李宗盛"
  },
  {
   "start": 30.0,
   "end": 34.0,
   "text": "我把余生往返回的哈姆拉比堡里"
  },
  {
   "start": 34.0,
   "end": 36.0,
   "text": "刻在一字的心无言"
  },
  {
   "start": 36.0,
   "end": 38.0,
   "text": "记起三千七百多年"
  },
  {
   "start": 38.0,
   "end": 40.0,
   "text": "你在出场前"
  },
  {
   "start": 40.0,
   "end": 42.0,
   "text": "凝视悲欢的字眼"
  },
  {
   "start": 42.0,
   "end": 44.0,
   "text": "我且在旁静静欣赏你"
  },
  {
   "start": 44.0,
   "end": 46.0,
   "text": "那张我深爱的脸"
  },
  {
   "start": 46.0,
   "end": 49.0,
   "text": "即使是身边挣扎的空间"
  },
  {
   "start": 49.0,
   "end": 50.0,
   "text": "是谁的从前"
  },
  {
   "start": 50.0,
   "end": 51.0,
   "text": "希望在人潮中"
  },
  {
   "start": 51.0,
   "end": 54.0,
   "text": "你却属于我的那画面"
  },
  {
   "start": 54.0,
   "end": 56.0,
   "text": "经过深美一瞬间"
  },
  {
   "start": 56.0,
   "end": 58.0,
   "text": "我与你深深迷去夜"
  },
  {
   "start": 58.0,
   "end": 62.0,
   "text": "心底下滴個綠色紛亂的滿臉"
  },
  {
   "start": 62.0,
   "end": 68.0,
   "text": "能顧問明著剩下難解的語言"
  },
  {
   "start": 68.0,
   "end": 77.0,
   "text": "成熟糾纏的 永垂不朽的詩篇"
  },
  {
   "start": 77.0,
   "end": 80.0,
   "text": "我給你的愛卻在心眼前"
  },
  {
   "start": 80.0,
   "end": 84.0,
   "text": "什麼都還沒說不下去啊"
  },
  {
   "start": 84.0,
   "end": 88.0,
   "text": "即使个世界有诸多发现"
  },
  {
   "start": 88.0,
   "end": 92.0,
   "text": "你抱上的自己依然静静可见"
  },
  {
   "start": 92.0,
   "end": 95.0,
   "text": "我给你的爱是在心眼前"
  },
  {
   "start": 95.0,
   "end": 100.0,
   "text": "是埋在你说不到你眼里"
  },
  {
   "start": 100.0,
   "end": 103.0,
   "text": "用些经文字刻下了永远"
  },
  {
   "start": 103.0,
   "end": 106.0,
   "text": "那一封花千年的誓言"
  },
  {
   "start": 106.0,
   "end": 110.0,
   "text": "一切有尊严"
  },
  {
   "start": 110.0,
   "end": 113.0,
   "text": "即使升天 占占空间"
  },
  {
   "start": 113.0,
   "end": 114.96,
   "text": "是谁的从前"
  },
  {
   "start": 114.96,
   "end": 116.16,
   "text": "寂寞在人潮中"
  },
  {
   "start": 116.16,
   "end": 118.72,
   "text": "你是属于我的那画面"
  },
  {
   "start": 118.72,
   "end": 120.68,
   "text": "经过数美丽山顺便"
  },
  {
   "start": 120.68,
   "end": 123.04,
   "text": "我与你散着冰雪烟"
  },
  {
   "start": 123.04,
   "end": 126.84,
   "text": "正面像皮革丽丝盒般的蔓延"
  },
  {
   "start": 126.84,
   "end": 128.8,
   "text": "但不问名字"
  },
  {
   "start": 128.8,
   "end": 133.04,
   "text": "剩下难解的语言"
  },
  {
   "start": 133.04,
   "end": 135.12,
   "text": "而成熟就成了"
  },
  {
   "start": 135.12,
   "end": 142.04,
   "text": "永水不朽的诗篇"
  },
  {
   "start": 142.04,
   "end": 144.62,
   "text": "我给你的爱 写在心愿间"
  },
  {
   "start": 144.62,
   "end": 149.56,
   "text": "是麦达米 索布达米 鸭皮鸭"
  },
  {
   "start": 149.56,
   "end": 152.22,
   "text": "提着个诗 提到处就发现"
  },
  {
   "start": 152.22,
   "end": 157.1,
   "text": "你把上的自己 仍静静和静"
  },
  {
   "start": 157.1,
   "end": 159.66,
   "text": "我给你的爱 写在心愿间"
  },
  {
   "start": 159.66,
   "end": 164.74,
   "text": "是麦达米 索布达米 鸭皮鸭"
  },
  {
   "start": 164.74,
   "end": 167.34,
   "text": "用些心 问自己下了永远"
  },
  {
   "start": 167.34,
   "end": 171.84,
   "text": "那一封花 剪裂的誓言"
  },
  {
   "start": 171.84,
   "end": 174.84,
   "text": "當我感到很疲倦"
  },
  {
   "start": 174.84,
   "end": 178.52,
   "text": "你假像還是很遠"
  },
  {
   "start": 178.52,
   "end": 187.52,
   "text": "害怕再也不能回到你身邊"
  },
  {
   "start": 187.52,
   "end": 189.92,
   "text": "我逼你的愛 逼著心結"
  },
  {
   "start": 189.92,
   "end": 195.04,
   "text": "我心懷難 說不到你要平安"
  },
  {
   "start": 195.04,
   "end": 197.24,
   "text": "提前的設計 幫助了我"
  },
  {
   "start": 197.24,
   "end": 200.74,
   "text": "你把相对自己的情绪和解"
  },
  {
   "start": 200.74,
   "end": 204.74,
   "text": "我给你的爱结在幸运间"
  },
  {
   "start": 204.74,
   "end": 207.74,
   "text": "不是麻烦别说不道别"
  },
  {
   "start": 209.74,
   "end": 212.74,
   "text": "拥戒亲吻只割下了永远"
  },
  {
   "start": 212.74,
   "end": 214.74,
   "text": "那一封花钱"
  },
  {
   "start": 214.74,
   "end": 216.74,
   "text": "你带着远的一切"
  },
  {
   "start": 216.74,
   "end": 224.26,
   "text": "在我眼前"
  },
  {
   "start": 224.26,
   "end": 229.26,
   "text": "在我眼前"
  }
 ]
}

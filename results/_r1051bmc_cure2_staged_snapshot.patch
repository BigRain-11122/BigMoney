-        return 2
-
-    print("CARD-LINT PASS (%d/%d elements present%s)"
-          % (len(checks), len(checks), ", --min row-level" if minimum else ""))
-    return 0
-
-
-if __name__ == "__main__":
-    sys.exit(main(sys.argv))

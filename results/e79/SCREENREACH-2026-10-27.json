   "sh510050",
   "sh510300",
   "sh510500",
   "sh512100",
   "sh588000"
  ],
  "names_neutralised": "screen_report.names entries whose action == 'neutralise'",
  "ladder_row_is_a_control": "no ladder name appears in that neutralised set; null when the face publishes no census (unknown, not true)",
  "repair": "pair.summary.cells_moved, else answers.non_zero_delta_cells, else the count of non-zero delta rows in delta / delta_table",
  "refresh": "cutoff_control.summary.cells_moved; absent means the face cannot rank the two effects at all",
  "ordering_bands": {
   "repair_dominates": "repair / refresh >= 1.25",
   "refresh_dominates": "repair / refresh <= 0.80",
   "tied": "between the bands; neither number may be quoted alone",
   "refresh_zero": "cutoff_control moved 0 cells, the ratio is undefined",
   "no_cutoff_control": "flag, not a verdict"
  }
 },

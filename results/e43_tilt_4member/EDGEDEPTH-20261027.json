   2,
   4,
   6,
   8,
   10
  ],
  "chrono_edges_note": "E195's chrono_edges is the k=2 member of this family; the sweep exists because that rule removed 1.2% of a 162-month era",
  "magnitude_rules": [
   "book_mad3",
   "book_gross_x2",
   "book_top_decile"
  ],
  "units": "era effects in bp; depth in months; fraction of the era",
  "join_tolerance_bp": 0.01,
  "class_rules": {
   "edge_kill_is_cheaper_than_every_magnitude_kill": "the reversal dies under a shallower edge trim than any magnitude rule needs, so E195's survival was depth",
   "magnitude_rule_kills_cheaper_than_the_edge_trim": "an answer-blind magnitude rule kills with fewer months",
   "edge_and_magnitude_kills_cost_the_same": "the two families need the same depth",
   "survives_even_the_deepest_edge_trim": "no edge depth in the sweep kills it and no magnitude rule does either -- a real insensitivity",
   "edge_never_kills_but_a_magnitude_rule_does": "only the book-return rules can kill it, so the verdict rests on which months were flagged, not on era depth",
   "no_base_reversal": "nothing to test on this pair"
  },
  "monotonicity_note": "k_stop is the FIRST depth at which the reversal is gone; where the reversal returns at a deeper k it is reported as revival_at_k<first>_after_dying_at_k<stop> and the pair is not a threshold case at all"
 },

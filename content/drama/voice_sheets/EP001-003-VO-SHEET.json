   "vo_ref": "GAP:NARRATOR(no bank entry)",
   "emotion": "solemn",
   "text": "1993 年 6 月 17 日，我父亲教了我最后一课。",
   "est_sec": 5.4,
   "shot_window_s": 3,
   "fit": "OVERFLOW",
   "flags": []
  },
  {

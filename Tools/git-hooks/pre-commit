#!/bin/sh
# BigMoney pre-commit claw: BLOCK commits that stage unresolved conflict markers.
# Adoption of group decision D-20260927-05 item (iii). Multi-machine push-collision
# lineage r161..r331: markers that slip into a commit become history (the 20:4x
# event); this claw makes "resolve before commit" mechanical, at the single
# write-side gate (r329: reading marker-laden worktree files is contamination).
# Scope: only git's "leftover conflict marker" findings block. Whitespace notes
# pass through. Rebase replays are not affected (rebase does not run this hook).
# Escape hatch for canon-doc edits that legitimately quote marker lines:
#   git commit --no-verify   (state the reason in the round report)
# Install/refresh: powershell -NoProfile -ExecutionPolicy Bypass -File Tools\register_precommit_claw.ps1
#
# r1305: round 1304 shipped a stray "||||||| parent of b860cfedf0" line inside
# knowledge/METHODOLOGY_ASSETS.md, past a claw byte-identical to this file. Probed on
# 2026-10-27: git diff --cached --check DOES flag a base marker, and a staged probe file
# was blocked, so the commit path that let it through was one that skips this hook
# (rebase replay / --no-verify), not a blind spot in git. The grep below is therefore a
# second, independent check on ADDED lines only -- it fires even if the --check wording
# changes, and it leaves canon prose that quotes a marker alone. The real lesson stays
# with the rebase path: after any rebase, re-read the resolved file before committing.
out=$(git diff --cached --check 2>/dev/null | grep 'leftover conflict marker')
if [ -n "$out" ]; then
    echo "PRE-COMMIT CLAW: unresolved conflict markers staged (D-20260927-05 item-iii)."
    echo "Resolve per .codely-cli/skills/bigmoney-conflict-resolve/SKILL.md, then re-commit."
    echo "$out"
    exit 1
fi
base=$(git diff --cached -U0 --diff-filter=ACMR 2>/dev/null | grep -E '^\+\|\|\|\|\|\|\|')
if [ -n "$base" ]; then
    echo "PRE-COMMIT CLAW: a git base marker '|||||||' is being added (r1305)."
    echo "Delete the line (or quote it inside prose) before committing."
    echo "$base" | head -5
    exit 1
fi
# r1406: the forward ledger shipped on 2026-11-07 with a missing comma between two
# list elements AND a `drift` block carrying `faces`/`max_abs` twice. Neither defect
# leaves a conflict marker, so the legs above cannot see it, and `json.loads` keeps
# the LAST duplicate key silently -- readers then report an old measurement as the
# current one. This leg judges the STAGED BLOB (never the worktree copy beside it)
# exactly as a reader opens it. It prints nothing when the staged faces are clean,
# so a normal commit's output is unchanged.
if command -v python >/dev/null 2>&1; then
    root=$(git rev-parse --show-toplevel 2>/dev/null)
    if [ -n "$root" ] && [ -f "$root/Tools/json_face_guard.py" ]; then
        if ! python "$root/Tools/json_face_guard.py" --staged; then
            echo "PRE-COMMIT CLAW: a staged JSON face will not open for its readers (r1406)."
            echo "Fix the parse error / duplicate key, re-stage, then commit."
            echo "Escape hatch (state the reason in the round report): git commit --no-verify"
            exit 1
        fi
    fi
fi
exit 0